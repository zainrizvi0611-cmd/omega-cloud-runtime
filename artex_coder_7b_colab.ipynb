      "source": [
        "# 1. Install Dependencies & Cloudflared Tunnel\n",
        "!pip install -q torch transformers>=4.45.0 accelerate>=0.26.0 bitsandbytes>=0.43.0 fastapi uvicorn pydantic\n",
        "!curl -L -s https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -o /usr/local/bin/cloudflared\n",
        "!chmod +x /usr/local/bin/cloudflared"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 2. Launch 0XARTEX Coder 7B API Server with 4-bit Quantization (Optimized Non-Blocking)\n",
        "import time, threading, subprocess, re, torch\n",
        "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
        "from fastapi import FastAPI\n",
        "from fastapi.responses import JSONResponse\n",
        "import uvicorn\n",
        "\n",
        "model_id = \"0XARTEX/artex-coder-7b\"\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "print(f\"[*] Device: {device.upper()}\")\n",
        "if device == \"cuda\":\n",
        "    print(f\"[*] GPU: {torch.cuda.get_device_name(0)}\")\n",
        "else:\n",
        "    print(\"[!] WARNING: GPU not detected. Go to Runtime -> Change runtime type -> T4 GPU\")\n",
        "\n",
        "print(f\"[*] Loading Tokenizer: {model_id}...\")\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_id, trust_remote_code=True)\n",
        "eos_ids = [tokenizer.eos_token_id] if tokenizer.eos_token_id is not None else []\n",
        "im_end_id = tokenizer.convert_tokens_to_ids(\"<|im_end|>\")\n",
        "if isinstance(im_end_id, int) and im_end_id not in eos_ids:\n",
        "    eos_ids.append(im_end_id)\n",
        "if tokenizer.pad_token_id is None:\n",
        "    tokenizer.pad_token_id = tokenizer.eos_token_id\n",
        "\n",
        "print(f\"[*] Loading Model: {model_id} in 4-bit...\")\n",
        "load_kwargs = {\"trust_remote_code\": True, \"device_map\": \"auto\"}\n",
        "if device == \"cuda\":\n",
        "    load_kwargs[\"torch_dtype\"] = torch.float16\n",
        "    load_kwargs[\"load_in_4bit\"] = True\n",
        "else:\n",
        "    load_kwargs[\"torch_dtype\"] = torch.float32\n",
        "\n",
        "model = AutoModelForCausalLM.from_pretrained(model_id, **load_kwargs)\n",
        "print(\"[+] Model successfully loaded!\")\n",
        "\n",
        "app = FastAPI(title=\"0XARTEX Coder 7B API\")\n",
        "\n",
        "@app.get(\"/\")\n",
        "@app.get(\"/health\")\n",
        "def health():\n",
        "    return {\"status\": \"online\", \"model\": model_id, \"device\": device, \"gpu\": torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"cpu\"}\n",
        "\n",
        "@app.get(\"/v1/models\")\n",
        "def models():\n",
        "    return {\"object\": \"list\", \"data\": [{\"id\": \"0XARTEX/artex-coder-7b\", \"object\": \"model\"}]}\n",
        "\n",
        "# Synchronous def executes in FastAPI ThreadPoolExecutor to prevent event-loop freeze\n",
        "@app.post(\"/v1/chat/completions\")\n",
        "def chat(body: dict):\n",
        "    try:\n",
        "        messages = body.get(\"messages\", [])\n",
        "        temperature = float(body.get(\"temperature\", 0.3))\n",
        "        max_tokens = min(int(body.get(\"max_tokens\", 512)), 1024)\n",
        "\n",
        "        prompt_text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
        "        inputs = tokenizer([prompt_text], return_tensors=\"pt\").to(model.device)\n",
        "        prompt_len = inputs["input_ids"].shape[1]\n",
        "\n",
        "        with torch.no_grad():\n",
        "            outputs = model.generate(\n",
        "                **inputs,\n",
        "                max_new_tokens=max_tokens,\n",
        "                temperature=temperature if temperature > 0 else 0.01,\n",
        "                do_sample=True if temperature > 0 else False,\n",
        "                pad_token_id=tokenizer.pad_token_id,\n",
        "                eos_token_id=eos_ids\n",
        "            )\n",
        "        generated_ids = outputs[0][prompt_len:]\n",
        "        response_text = tokenizer.decode(generated_ids, skip_special_tokens=True).strip()\n",
        "\n",
        "        return {\n",
        "            \"id\": f\"chatcmpl-{int(time.time())}\",\n",
        "            \"object\": \"chat.completion\",\n",
        "            \"created\": int(time.time()),\n",
        "            \"model\": \"0XARTEX/artex-coder-7b\",\n",
        "            \"choices\": [{\"index\": 0, \"message\": {\"role\": \"assistant\", \"content\": response_text}, \"finish_reason\": \"stop\"}],\n",
        "            \"usage\": {\"prompt_tokens\": prompt_len, \"completion_tokens\": len(generated_ids), \"total_tokens\": prompt_len + len(generated_ids)}\n",
        "        }\n",
        "    except Exception as e:\n",
        "        return JSONResponse(status_code=500, content={\"error\": {\"message\": str(e)}})\n",
        "\n",
        "def start_tunnel():\n",
        "    time.sleep(3)\n",
        "    proc = subprocess.Popen([\"/usr/local/bin/cloudflared\", \"tunnel\", \"--url\", \"http://127.0.0.1:8000\"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\n",
        "    for line in proc.stdout:\n",
        "        if \"trycloudflare.com\" in line:\n",
        "            match = re.search(r\"https://[a-zA-Z0-9-]+\\.trycloudflare\\.com\", line)\n",
        "            if match:\n",
        "                url = match.group(0)\n",
        "                print(\"\n",
        "\" + \"=\"*60)\n",
        "                print(\"\ud83d\ude80 YOUR ARTEX ENDPOINT URL:\")\n",
        "                print(f\"{url}/v1\")\n",
        "                print(\"=\"*60 + \"\n",
        "\")\n",
        "                break\n",
        "\n",
        "threading.Thread(target=start_tunnel, daemon=True).start()\n",
        "uvicorn.run(app, host=\"0.0.0.0\", port=\"8000\", log_level=\"warning\")\n"
      ]
    }
